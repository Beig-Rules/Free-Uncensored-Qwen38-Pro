        "!pip install -q huggingface_hub > /dev/null 2>&1\\n",
        "\\n",
        "os.makedirs(MODEL_DIR, exist_ok=True)\\n",
        "\\n",
        "LLAMA_DIR = \\"/content/llama.cpp\\"\\n",
