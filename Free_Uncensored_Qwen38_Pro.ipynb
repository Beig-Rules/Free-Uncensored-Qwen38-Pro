        "    print(f\\"✅ مدل با موفقیت دانلود شد\\")\\n",
        "    print(f\\"مسیر: {downloaded}\\")\\n",
        "except Exception as e:\\n",
        "    print(\\"❌ خطا در دانلود مدل:\\")\\n",
        "    print(str(e)[:500])\\n",
        "    print(\\"\\nاگر مدل نیاز به دسترسی دارد، یک توکن رایگان از لینک زیر بسازید و در سلول ۱ قرار دهید:\\")\\n",
        "    print(\\"https://huggingface.co/settings/tokens\\")\\n",
