      "source": [
        "# Free-Uncensored-Qwen38-Pro\\n",
        "\\n",
        "**نسخه پیشرفته اجرای مدل‌های Uncensored Qwen3.8-27B روی Colab رایگان (T4)**\\n",
        "\\n",
        "این نوت‌بوک از ایده و ساختار پروژه [MorTsaedi](https://github.com/MorTsaedi/Free-Uncensored-Qwen3.8-27B) الهام گرفته و بهبودهای مهمی در پایداری، پشتیبانی چندمدلی و تجربه کاربری دارد.\\n",
        "\\n",
        "**ترتیب اجرا:** سلول ۱ (تنظیمات) → سلول ۲ (نصب و دانلود) → سلول ۳ (شروع سرور و تونل)\\n",
        "\\n",
        "**مهم:** قبل از شروع Runtime → Change runtime type → T4 GPU را انتخاب کنید."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title ۱ - تنظیمات (Configuration)\\n",
        "\\n",
        "PASSWORD = \\"changeme123\\"          # <-- رمز SSH را حتماً عوض کنید\\n",
        "HF_TOKEN = \\"\\"                    # توکن Hugging Face (اختیاری اما توصیه می‌شود)\\n",
        "SERVER_PORT = 3005\\n",
        "SSH_PORT = 22\\n",
        "\\n",
        "# --- انتخاب مدل Uncensored ---\\n",
        "# گزینه‌های پیشنهادی:\\n",
        "# 1. OBLITERATUS (پیشنهادی پیش‌فرض)\\n",
        "MODEL_REPO = \\"OBLITERATUS/Qwen3.8-27B-OBLITERATED\\"\\n",
        "MODEL_QUANT = \\"Q3_K_M\\"          # ایمن برای T4 (~13.5GB)\\n",
        "# MODEL_QUANT = \\"IQ4_XS\\"       # کیفیت بالاتر (ممکن است تنگ شود)\\n",
        "\\n",
        "MODEL_FILE = f\\"Qwen3.8-27B-OBLITERATED-{MODEL_QUANT}.gguf\\"\\n",
        "MODEL_URL = f\\"https://huggingface.co/{MODEL_REPO}/resolve/main/{MODEL_FILE}\\"\\n",
        "MODEL_DIR = \\"/content/models\\"\\n",
        "MODEL_PATH = f\\"{MODEL_DIR}/{MODEL_FILE}\\"\\n",
        "\\n",
        "N_GPU_LAYERS = 99\\n",
        "KV_CACHE_TYPE = \\"q4_0\\"\\n",
        "CTX_SIZE = 32768\\n",
        "N_PARALLEL = 1\\n",
        "\\n",
        "print(\\"تنظیمات آماده شد.\\")\\n",
        "print(f\\"مدل: {MODEL_REPO} | Quant: {MODEL_QUANT}\\")\\n",
        "print(\\"رمز SSH را فراموش نکنید تغییر دهید!\\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title ۲ - نصب و دانلود مدل (چند دقیقه طول می‌کشد)\\n",
        "\\n",
        "import os, subprocess, time\\n",
        "from pathlib import Path\\n",
        "\\n",
        "os.makedirs(MODEL_DIR, exist_ok=True)\\n",
        "\\n",
        "print(\\"در حال نصب وابستگی‌ها...\\")\\n",
        "!apt-get update -qq && apt-get install -y -qq openssh-server > /dev/null\\n",
        "!pip install -q huggingface_hub\\n",
        "\\n",
        "# نصب llama.cpp (نسخه پیش‌ساخته یا کامپایل)\\n",
        "print(\\"در حال آماده‌سازی llama.cpp...\\")\\n",
        "!curl -L https://github.com/ggerganov/llama.cpp/releases/latest/download/llama-bXXXX-bin-ubuntu-x64.zip -o llama.zip 2>/dev/null || true\\n",
        "# در صورت نیاز کامپایل ساده\\n",
        "if not Path(\\"/content/llama.cpp/llama-server\\").exists():\\n",
        "    !git clone --depth 1 https://github.com/ggerganov/llama.cpp.git /content/llama.cpp\\n",
        "    %cd /content/llama.cpp\\n",
        "    !make -j$(nproc) LLAMA_CUDA=1 llama-server 2>/dev/null || make -j$(nproc) llama-server\\n",
        "    %cd /content\\n",
        "\\n",
        "print(\\"دانلود مدل (ممکن است ۵ تا ۱۵ دقیقه طول بکشد)...\\")\\n",
        "from huggingface_hub import hf_hub_download\\n",
        "try:\\n",
        "    path = hf_hub_download(repo_id=MODEL_REPO, filename=MODEL_FILE, local_dir=MODEL_DIR, token=HF_TOKEN or None)\\n",
        "    print(f\\"مدل دانلود شد: {path}\\")\\n",
        "except Exception as e:\\n",
        "    print(\\"خطا در دانلود:\", e)\\n",
        "    print(\\"اگر مدل gated است، HF_TOKEN را در سلول ۱ وارد کنید.\\")\\n",
        "\\n",
        "print(\\"نصب کامل شد.\\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# @title ۳ - راه‌اندازی SSH + llama-server + تونل bore (سلول اصلی)\\n",
        "\\n",
        "import subprocess, threading, time, os, socket\\n",
        "from IPython.display import clear_output\\n",
        "\\n",
        "# تنظیم SSH\\n",
        "!mkdir -p /var/run/sshd\\n",
        "!echo \\"root:{PASSWORD}\\" | chpasswd\\n",
        "!echo \\"PermitRootLogin yes\\" >> /etc/ssh/sshd_config\\n",
        "!echo \\"PasswordAuthentication yes\\" >> /etc/ssh/sshd_config\\n",
        "!service ssh start\\n",
        "\\n",
        "print(\\"SSH آماده شد.\\")\\n",
        "\\n",
        "# شروع llama-server\\n",
        "server_cmd = [\\n",
        "    \\"/content/llama.cpp/llama-server\\",\\n",
        "    \\"-m\\", MODEL_PATH,\\n",
        "    \\"--host\\", \\"127.0.0.1\\",\\n",
        "    \\"--port\\", str(SERVER_PORT),\\n",
        "    \\"-c\\", str(CTX_SIZE),\\n",
        "    \\"-ngl\\", str(N_GPU_LAYERS),\\n",
        "    \\"--jinja\\",\\n",
        "]\\n",
        "\\n",
        "print(\\"در حال شروع llama-server...\\")\\n",
        "server_proc = subprocess.Popen(server_cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\\n",
        "time.sleep(8)\\n",
        "\\n",
        "# تونل bore\\n",
        "print(\\"در حال راه‌اندازی تونل bore...\\")\\n",
        "!curl -L https://github.com/ekzhang/bore/releases/latest/download/bore-v0.5.0-x86_64-unknown-linux-musl.tar.gz | tar xz -C /tmp\\n",
        "bore_proc = subprocess.Popen([\\"/tmp/bore\\", \\"local\\", \\"22\\", \\"--to\\", \\"bore.pub\\"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\\n",
        "\\n",
        "# خواندن پورت bore\\n",
        "bore_port = None\\n",
        "for _ in range(30):\\n",
        "    line = bore_proc.stdout.readline()\\n",
        "    if \\"listening at\\" in line.lower() or \\"bore.pub:\\" in line:\\n",
        "        import re\\n",
        "        m = re.search(r'bore\\.pub:(\\\\d+)', line)\\n",
        "        if m:\\n",
        "            bore_port = m.group(1)\\n",
        "            break\\n",
        "    time.sleep(0.5)\\n",
        "\\n",
        "if bore_port:\\n",
        "    print(\\"========================================\\")\\n",
        "    print(\\"سرور آماده است!\\")\\n",
        "    print(f\\"پورت bore: {bore_port}\\")\\n",
        "    print(\\"\\")\\n",
        "    print(\\"دستور SSH:\\")\\n",
        "    print(f\\"ssh -o StrictHostKeyChecking=no -p {bore_port} root@bore.pub\\")\\n",
        "    print(\\"رمز:\\", PASSWORD)\\n",
        "    print(\\"\\")\\n",
        "    print(\\"Forward API به لوکال:\\")\\n",
        "    print(f\\"ssh -N -o StrictHostKeyChecking=no -p {bore_port} -L {SERVER_PORT}:127.0.0.1:{SERVER_PORT} root@bore.pub\\")\\n",
        "    print(\\"\\")\\n",
        "    print(f\\"بعد از forward، Web UI: http://localhost:{SERVER_PORT}\\")\\n",
        "    print(\\"========================================\\")\\n",
        "else:\\n",
        "    print(\\"نتوانست پورت bore را بگیرد. دوباره تلاش کنید.\\")\\n",
        "\\n",
        "# Keep-alive ساده اما قوی\\n",
        "def keep_alive():\\n",
        "    while True:\\n",
        "        time.sleep(60)\\n",
        "        print(\\".\\", end=\\"\\", flush=True)\\n",
        "\\n",
        "threading.Thread(target=keep_alive, daemon=True).start()\\n",
        "print(\\"Keep-alive فعال شد. تب مرورگر را باز نگه دارید.\\")"
      ]
    },
    {
      "cell_type": "markdown",
