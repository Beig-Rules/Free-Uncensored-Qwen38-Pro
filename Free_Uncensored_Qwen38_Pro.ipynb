        "    !rm -rf {LLAMA_DIR}\\n",
        "    !git clone --depth 1 https://github.com/ggml-org/llama.cpp.git {LLAMA_DIR} > /dev/null 2>&1\\n",
        "    %cd {LLAMA_DIR}\\n",
        "    !cmake -B build -DGGML_CUDA=ON > /dev/null 2>&1 || cmake -B build > /dev/null 2>&1\\n",
        "    !cmake --build build --config Release -j$(nproc) --target llama-server > /dev/null 2>&1\\n",
        "    %cd /content\\n",
        "    if Path(f\\"{LLAMA_DIR}/build/bin/llama-server\\").exists():\\n",
        "        !cp {LLAMA_DIR}/build/bin/llama-server {LLAMA_DIR}/llama-server\\n",
        "        print(\\"✅ llama-server با موفقیت ساخته شد\\")\\n",
        "    else:\\n",
        "        print(\\"⚠️ تلاش با make...\\")\\n",
        "        %cd {LLAMA_DIR}\\n",
        "        !make -j$(nproc) llama-server > /dev/null 2>&1\\n",
        "        %cd /content\\n",
        "        if Path(f\\"{LLAMA_DIR}/llama-server\\").exists():\\n",
        "            print(\\"✅ llama-server آماده شد\\")\\n",
